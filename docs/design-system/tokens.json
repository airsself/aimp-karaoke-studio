{
  "name": "AIMP Karaoke Studio · Focused Lyrics",
  "version": "1.0.0",
  "platform": "WPF .NET 10 / Windows",
  "units": "DIP",
  "baseline": 4,
  "sourcesOfTruth": {
    "paletteAndPrimitives": "app/Styles/Tokens.xaml",
    "componentStyles": "app/Styles/Components.xaml",
    "structuralGeometry": "app/Design/DesignMetrics.cs"
  },
  "colors": {
    "WindowBrush": "#101114",
    "StageBrush": "#0D0E11",
    "ChromeBrush": "#16171B",
    "ToolbarBrush": "#19191F",
    "DrawerBrush": "#19191F",
    "StrokeBrush": "#373540",
    "SubtleStrokeBrush": "#292831",
    "ControlBrush": "#24232B",
    "ControlHoverBrush": "#302C38",
    "ControlPressedBrush": "#3B3348",
    "SurfaceBrush": "#17171D",
    "SurfaceRaisedBrush": "#202027",
    "TextBrush": "#F0EDF6",
    "SecondaryBrush": "#C4BECD",
    "DimBrush": "#A19BAE",
    "AccentBrush": "#8A7BB7",
    "AccentSurfaceBrush": "#342B46",
    "AccentHoverBrush": "#453657",
    "HighlightBrush": "#DDD2FF",
    "FocusRingBrush": "#D7CBFF",
    "SuccessBrush": "#9BCAA9",
    "WarningBrush": "#EDBF91",
    "ErrorBrush": "#F2ADB4",
    "SelectionBrush": "#342C46",
    "LyricsSungBrush": "#F3EEFF",
    "LyricsActiveBrush": "#CFC2ED",
    "LyricsNextBrush": "#DDD1F5",
    "LyricsNearBrush": "#B5ADC6",
    "LyricsFarBrush": "#AAA3BB"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radii": {
    "small": 4,
    "control": 6,
    "card": 8
  },
  "controls": {
    "normalHeight": 36,
    "compactHeight": 32,
    "searchResultMinHeight": 52,
    "dialogGutter": 24,
    "drawerGutter": 20
  },
  "type": {
    "caption": 10,
    "label": 11,
    "body": 12,
    "heading": 16,
    "display": 24,
    "lyricsActive": "24–100 adjustable",
    "fontFamily": "Segoe UI",
    "timestamps": "Consolas"
  },
  "geometry": {
    "HeaderHeight": 40,
    "ToolbarHeight": 64,
    "FooterHeight": 64,
    "SettingsWidth": 320,
    "OverlayBreakpoint": 980,
    "CompactChromeBreakpoint": 1100,
    "CompactFooterBreakpoint": 880,
    "OverlayInset": 12
  },
  "states": [
    "default",
    "hover",
    "pressed",
    "keyboard-focus",
    "selected",
    "disabled"
  ],
  "accessibility": {
    "standardTextContrast": "at least 4.5:1",
    "focusVisible": true,
    "minimumInteractiveHeight": 32,
    "keyboardNavigation": true
  },
  "exceptions": [
    "Lyric font sizes are user-adjustable and require variable line heights",
    "Accent palette swatches are literal selectable colors",
    "Realtime LRC highlight colors have dedicated semantic tokens"
  ]
}
