<Window x:Class="KaraokeStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AIMP Karaoke Studio" Width="1194" Height="760" MinWidth="710" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing"
        KeyDown="Window_KeyDown" PreviewMouseWheel="Window_PreviewMouseWheel" SizeChanged="Window_SizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#39363F" BorderThickness="1" Background="{StaticResource WindowBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="HeaderRow" Height="38"/>
        <RowDefinition x:Name="ToolbarRow" Height="62"/>
        <RowDefinition Height="*"/>
        <RowDefinition x:Name="FooterRow" Height="60"/>
      </Grid.RowDefinitions>

      <!-- AIMP-like titlebar; Windows resizing remains active via WindowChrome. -->
      <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource StrokeBrush}"
              BorderThickness="0,0,0,1" MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
        <Grid Margin="14,0,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="19" Height="18" Background="#1E1E21" BorderBrush="#4B4753" BorderThickness="1"
                  CornerRadius="2" VerticalAlignment="Center">
            <TextBlock Text="A" Foreground="#D7D2E3" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Grid.Column="1" Text="AIMP Karaoke Studio" Foreground="#CECDD2" FontSize="11" Margin="10,0,12,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="FOCUSED LYRICS" Foreground="#898493" FontSize="10" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
            <Button Content="−" ToolTip="Свернуть" Style="{StaticResource WindowControl}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
            <Button x:Name="MaximizeButton" Content="□" ToolTip="Развернуть" Style="{StaticResource WindowControl}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
            <Button Content="×" ToolTip="Закрыть" Style="{StaticResource WindowControl}"
                    Foreground="#C6A4AC" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Track strip + display modes -->
      <Border Grid.Row="1" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Width="43" Height="43" Margin="0,0,12,0" VerticalAlignment="Center">
            <Border BorderBrush="#38373B" BorderThickness="1" Background="#252428" CornerRadius="2"/>
            <TextBlock x:Name="CoverPlaceholder" Text="♪" FontSize="22" Foreground="#797486" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image x:Name="CoverImage" Stretch="UniformToFill"/>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
            <TextBlock x:Name="TrackTitle" Text="Ожидание AIMP" FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TrackArtist" Text="Откройте композицию в проигрывателе" Style="{StaticResource SmallText}" Margin="0,3,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#77757F" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <TextBlock x:Name="StatusText" Text="Подключение…" Foreground="#777680" FontSize="10"/>
              <TextBlock Text=" · " Foreground="#67656E" FontSize="10"/>
              <TextBlock x:Name="SourceText" Text="Нет текста" Foreground="#777680" FontSize="10"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" Background="#131217"
                  BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="4" Padding="3">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ReadingButton" Content="Чтение" Style="{StaticResource ModeButton}" Click="Reading_Click"/>
              <Button x:Name="KaraokeButton" Content="Караоке" Style="{StaticResource ModeButton}" Click="Karaoke_Click"/>
              <Button x:Name="StageButton" Content="Сцена" Style="{StaticResource ModeButton}" Click="Stage_Click"/>
            </StackPanel>
          </Border>
          <Button x:Name="TranslationButton" Grid.Column="3" Content="RU · Перевод"
                  Style="{StaticResource OutlineButton}" Margin="0,0,9,0" VerticalAlignment="Center"
                  ToolTip="Разделить окно на оригинал и автоматический перевод на русский" Click="Translation_Click"/>
          <Button x:Name="SettingsButton" Grid.Column="4" Content="⚙  Настройки" Style="{StaticResource OutlineButton}"
                  Margin="0" VerticalAlignment="Center" Click="Settings_Click"/>
        </Grid>
      </Border>

      <!-- Lyrics surface + 298 DIP collapsible drawer -->
      <Grid Grid.Row="2" ClipToBounds="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsColumn" Width="0"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource StageBrush}" ClipToBounds="True">
          <Image x:Name="AmbientImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False">
            <!-- The ambient cover is static; cache its composited bitmap at
                 reduced resolution rather than blurring the full-screen scene. -->
            <Image.CacheMode><BitmapCache RenderAtScale="0.35"/></Image.CacheMode>
            <Image.Effect><BlurEffect Radius="18"/></Image.Effect>
          </Image>
          <Rectangle Fill="#C70D0E11" IsHitTestVisible="False"/>
          <!-- Vocal Focus is a soft atmospheric focus, not a framed panel. -->
          <Rectangle Panel.ZIndex="1" IsHitTestVisible="False" Opacity="0.46">
            <Rectangle.Fill>
              <RadialGradientBrush RadiusX="0.62" RadiusY="0.48" Center="0.5,0.43" GradientOrigin="0.5,0.43">
                <GradientStop Color="#372940" Offset="0"/>
                <GradientStop Color="#17131C" Offset="0.55"/>
                <GradientStop Color="#101011" Offset="1"/>
              </RadialGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Border x:Name="TranslationDivider" Panel.ZIndex="3" Width="1"
                  Background="#393341" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  IsHitTestVisible="False" Visibility="Collapsed"/>
          <!-- A single virtualized list contains both columns: wrapped translations
               cannot drift away from their original timestamped lyric line. -->
          <Grid x:Name="TranslationHeader" Panel.ZIndex="3" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="28,14,28,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="ОРИГИНАЛ" Foreground="{DynamicResource SecondaryBrush}" FontSize="10"
                       HorizontalAlignment="Center"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" MaxWidth="350">
              <TextBlock Text="РУССКИЙ ПЕРЕВОД" Foreground="#D7C7F4" FontSize="10"
                         FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="TranslationStatus" Text="Ожидаем текст песни" Foreground="#9892A5"
                         FontSize="10" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="SyncIndicator" Text="ПОСТРОЧНАЯ СИНХРОНИЗАЦИЯ" Foreground="{DynamicResource SecondaryBrush}" FontSize="10"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,17,20,0" Panel.ZIndex="3"/>
          <ListBox x:Name="LyricsItems" Panel.ZIndex="2" Margin="20,0" Background="Transparent" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                   Focusable="False" SizeChanged="ScrollArea_SizeChanged" PreviewMouseWheel="LyricsItems_PreviewMouseWheel">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Focusable" Value="False"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                  </ControlTemplate></Setter.Value></Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Visibility="{Binding Visibility}" Padding="{Binding Padding}" HorizontalAlignment="Stretch"
                          MouseLeftButtonUp="LyricLine_MouseLeftButtonUp" Tag="{Binding StartMs}" Cursor="Hand">
                    <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
                      <Border DockPanel.Dock="Right" Width="{Binding TranslationPaneWidth}"
                              Visibility="{Binding TranslationVisibility}" Padding="19,0,9,0">
                        <TextBlock Text="{Binding TranslationText, Mode=OneWay}" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center" MaxWidth="820"
                                   FontFamily="Segoe UI" FontSize="{Binding TranslationFontSize}"
                                   FontWeight="{Binding Weight}" LineHeight="{Binding LineHeight}"
                                   LineStackingStrategy="BlockLineHeight" Foreground="{Binding Foreground}"
                                   Opacity="{Binding Opacity}"/>
                      </Border>
                      <Border Padding="10,0,14,0">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center" MaxWidth="850"
                                   FontFamily="Segoe UI" FontSize="{Binding FontSize}" FontWeight="{Binding Weight}"
                                   LineHeight="{Binding LineHeight}" LineStackingStrategy="BlockLineHeight"
                                   Opacity="{Binding Opacity}" xml:space="preserve"><Run Text="{Binding HighlightedText, Mode=OneWay}" Foreground="{Binding HighlightForeground}"/><Run Text="{Binding RemainingText, Mode=OneWay}" Foreground="{Binding Foreground}"/></TextBlock>
                      </Border>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          <Button x:Name="ResumeFollowButton" Content="↳ Вернуться к текущей строке" Panel.ZIndex="4"
                  Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,18,18" Visibility="Collapsed" Click="ResumeFollow_Click"/>
          <StackPanel x:Name="EmptyPanel" Panel.ZIndex="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <TextBlock Text="♪" Foreground="#655D75" FontSize="35" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyHeadline" Text="Здесь появится текст песни" Foreground="#D8D4E1"
                       FontWeight="SemiBold" FontSize="23" TextAlignment="Center" Margin="0,13,0,0"/>
            <TextBlock x:Name="EmptyDescription" Text="Запустите композицию в AIMP или откройте LRC-файл."
                       Style="{StaticResource SmallText}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="450" Margin="0,11,0,0"/>
          </StackPanel>
        </Grid>

        <Border x:Name="SettingsDrawer" Grid.Column="1" Background="{StaticResource DrawerBrush}" Visibility="Collapsed"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel Margin="18,16,18,22">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Отображение текста" FontWeight="SemiBold" FontSize="13" Foreground="#E1DCE9" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="×" Style="{StaticResource ChromeButton}" ToolTip="Скрыть настройки" Click="Settings_Click"/>
              </Grid>
              <TextBlock Text="ТИПОГРАФИКА" Style="{StaticResource SectionHeading}"/>
              <DockPanel><TextBlock Text="Размер активной строки" Style="{StaticResource SmallText}"/>
                <TextBlock x:Name="FontValue" Text="42 px" Style="{StaticResource ValueText}" DockPanel.Dock="Right"/></DockPanel>
              <Slider x:Name="FontSlider" Minimum="24" Maximum="100" TickFrequency="2" Style="{StaticResource SettingSlider}" ValueChanged="SettingSlider_Changed"/>
              <DockPanel Margin="0,8,0,0"><TextBlock Text="Межстрочный интервал" Style="{StaticResource SmallText}"/>
                <TextBlock x:Name="SpacingValue" Text="1.48" Style="{StaticResource ValueText}" DockPanel.Dock="Right"/></DockPanel>
              <Slider x:Name="SpacingSlider" Minimum="1.10" Maximum="2.00" TickFrequency="0.04" Style="{StaticResource SettingSlider}" ValueChanged="SettingSlider_Changed"/>
              <DockPanel Margin="0,8,0,0"><TextBlock Text="Контраст соседних строк" Style="{StaticResource SmallText}"/>
                <TextBlock x:Name="ContrastValue" Text="43%" Style="{StaticResource ValueText}" DockPanel.Dock="Right"/></DockPanel>
              <Slider x:Name="ContrastSlider" Minimum="15" Maximum="95" TickFrequency="1" Style="{StaticResource SettingSlider}" ValueChanged="SettingSlider_Changed"/>
              <TextBlock Text="ЦВЕТ" Style="{StaticResource SectionHeading}"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="AccentAimp" Style="{StaticResource SwatchButton}" Tag="#8A7BB7" Background="#8A7BB7" Width="26" Height="26" Margin="0,0,9,0" BorderBrush="#BFB4D8" BorderThickness="2" ToolTip="AIMP · фиолетовый" Click="Accent_Click"/>
                <Button x:Name="AccentBlue" Style="{StaticResource SwatchButton}" Tag="#6C99A6" Background="#6C99A6" Width="26" Height="26" Margin="0,0,9,0" BorderBrush="Transparent" BorderThickness="2" ToolTip="Холодный голубой" Click="Accent_Click"/>
                <Button x:Name="AccentSage" Style="{StaticResource SwatchButton}" Tag="#90A593" Background="#90A593" Width="26" Height="26" Margin="0,0,9,0" BorderBrush="Transparent" BorderThickness="2" ToolTip="Шалфей" Click="Accent_Click"/>
                <Button x:Name="AccentWarm" Style="{StaticResource SwatchButton}" Tag="#C0ADA0" Background="#C0ADA0" Width="26" Height="26" BorderBrush="Transparent" BorderThickness="2" ToolTip="Тёплый" Click="Accent_Click"/>
              </StackPanel>
              <TextBlock Text="ПОВЕДЕНИЕ" Style="{StaticResource SectionHeading}"/>
              <DockPanel><TextBlock Text="Смещение синхронизации" Style="{StaticResource SmallText}"/>
                <TextBlock x:Name="OffsetValue" Text="+0 мс" Style="{StaticResource ValueText}" DockPanel.Dock="Right"/></DockPanel>
              <Slider x:Name="OffsetSlider" Minimum="-2000" Maximum="2000" TickFrequency="50" Style="{StaticResource SettingSlider}" ValueChanged="SettingSlider_Changed"/>
              <DockPanel Margin="0,8,0,0"><TextBlock Text="Фон из обложки" Style="{StaticResource SmallText}"/>
                <TextBlock x:Name="AmbienceValue" Text="10%" Style="{StaticResource ValueText}" DockPanel.Dock="Right"/></DockPanel>
              <Slider x:Name="AmbienceSlider" Minimum="0" Maximum="40" TickFrequency="1" Style="{StaticResource SettingSlider}" ValueChanged="SettingSlider_Changed"/>
              <CheckBox x:Name="SmoothCheck" Content="Плавная прокрутка" Style="{StaticResource SettingCheck}" Click="SettingCheck_Click"/>
              <CheckBox x:Name="ProgressCheck" Content="Караоке-подсветка текста" Style="{StaticResource SettingCheck}" Click="SettingCheck_Click"/>
              <CheckBox x:Name="TopCheck" Content="Поверх других окон" Style="{StaticResource SettingCheck}" Click="SettingCheck_Click"/>
              <TextBlock Text="ПОИСК ТЕКСТОВ" Style="{StaticResource SectionHeading}"/>
              <CheckBox x:Name="AutoFindCheck" Content="Автопоиск отсутствующих текстов"
                        Style="{StaticResource SettingCheck}" Click="SettingCheck_Click"/>
              <CheckBox x:Name="LegacyBridgeCheck" Content="Сначала проверять локальный Lyrics Bridge"
                        Style="{StaticResource SettingCheck}" Click="SettingCheck_Click"/>
              <TextBlock Text="Автопоиск отправляет исполнителя и название внешним сервисам LRCLIB / lyrics.ovh. Существующие метаданные аудиофайлов не изменяются. Сохранение в .lrc — только по кнопке."
                         Foreground="#9692A1" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock Text="ПЕРЕВОД" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="Язык оригинала" Style="{StaticResource SmallText}" Margin="0,0,0,6"/>
              <ComboBox x:Name="TranslationSourceCombo" Height="30" Background="#24212A"
                        Foreground="#ECEAF2" BorderBrush="#504658" Padding="7,3"
                        SelectionChanged="TranslationSource_Changed">
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#ECEAF2"/>
                    <Setter Property="Background" Value="#24212A"/>
                  </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Авто (EN / JA / KO / ZH / RU)" Tag="auto"/>
                <ComboBoxItem Content="Английский" Tag="en"/>
                <ComboBoxItem Content="Японский" Tag="ja"/>
                <ComboBoxItem Content="Корейский" Tag="ko"/>
                <ComboBoxItem Content="Китайский" Tag="zh-CN"/>
                <ComboBoxItem Content="Испанский" Tag="es"/>
                <ComboBoxItem Content="Французский" Tag="fr"/>
                <ComboBoxItem Content="Немецкий" Tag="de"/>
                <ComboBoxItem Content="Итальянский" Tag="it"/>
                <ComboBoxItem Content="Португальский" Tag="pt"/>
                <ComboBoxItem Content="Русский" Tag="ru"/>
              </ComboBox>
              <TextBlock Text="Источник перевода" Style="{StaticResource SmallText}" Margin="0,12,0,6"/>
              <ComboBox x:Name="TranslationProviderCombo" Height="30" Background="#24212A"
                        Foreground="#ECEAF2" BorderBrush="#504658" Padding="7,3"
                        SelectionChanged="TranslationProvider_Changed">
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#ECEAF2"/>
                    <Setter Property="Background" Value="#24212A"/>
                  </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Авто · доступные провайдеры" Tag="auto"/>
                <ComboBoxItem Content="MyMemory · без ключа" Tag="mymemory"/>
                <ComboBoxItem Content="LibreTranslate · свой сервер" Tag="libre"/>
                <ComboBoxItem Content="DeepL · API ключ" Tag="deepl"/>
              </ComboBox>
              <TextBlock Text="LibreTranslate · адрес HTTPS сервера" Style="{StaticResource SmallText}" Margin="0,10,0,5"/>
              <TextBox x:Name="LibreTranslateUrlInput" Height="29" Padding="5,4"
                       Background="#24212A" Foreground="#ECEAF2"
                       BorderBrush="#504658" LostFocus="LibreTranslateUrl_Changed"
                       ToolTip="Например https://translate.example.org или http://localhost:5000"/>
              <Button Content="↻  Повторить перевод" Style="{StaticResource OutlineButton}"
                      Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="TranslationRetry_Click"/>
              <TextBlock Text="Текст отправляется выбранному провайдеру только при включении перевода. Авто: LibreTranslate (если задан URL) → DeepL (если задан ключ) → MyMemory. Ключи: переменные среды LIBRETRANSLATE_API_KEY и DEEPL_AUTH_KEY. Для новых переменных перезапустите приложение. Переводы кешируются локально."
                         Foreground="#9692A1" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
              <TextBlock Text="КЛАВИШИ" Style="{StaticResource SectionHeading}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Пауза / запуск" Style="{StaticResource SmallText}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="Space" Style="{StaticResource ValueText}"/>
                <TextBlock Grid.Row="1" Text="Масштаб текста" Style="{StaticResource SmallText}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl ±" Style="{StaticResource ValueText}"/>
                <TextBlock Grid.Row="2" Text="Смещение" Style="{StaticResource SmallText}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Alt ← / →" Style="{StaticResource ValueText}"/>
                <TextBlock Grid.Row="3" Text="Полный экран" Style="{StaticResource SmallText}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="F11" Style="{StaticResource ValueText}"/>
                <TextBlock Grid.Row="4" Text="Скрыть настройки" Style="{StaticResource SmallText}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Esc" Style="{StaticResource ValueText}"/>
              </Grid>
              <TextBlock Text="Настройки сохраняются автоматически при закрытии окна."
                         TextWrapping="Wrap" Foreground="#77747E" FontSize="10" Margin="0,15,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Compact transport bar -->
      <Border Grid.Row="3" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="◀◀" Style="{StaticResource TransportButton}" ToolTip="Предыдущая композиция" Click="Previous_Click"/>
            <Button x:Name="PlayButton" Content="▶" Style="{StaticResource RoundPlay}" ToolTip="Пауза / воспроизведение" Click="Play_Click"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Width="34" Height="34" Margin="5,0"/>
            <Button Content="▶▶" Style="{StaticResource TransportButton}" ToolTip="Следующая композиция" Click="Next_Click"/>
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" Text="00:00" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Foreground="#A3A0AA" Margin="0,0,12,0"/>
            <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" Margin="0,0,0,0"
                    Style="{StaticResource SettingSlider}" VerticalAlignment="Center" PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" PreviewKeyUp="SeekSlider_PreviewKeyUp"/>
            <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Foreground="#A3A0AA" Margin="12,0,0,0"/>
          </Grid>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="A−" Style="{StaticResource OutlineButton}" ToolTip="Уменьшить текст (Ctrl+-)" Margin="0,0,7,0" Click="FontMinus_Click"/>
            <Button Content="A+" Style="{StaticResource OutlineButton}" ToolTip="Увеличить текст (Ctrl++)" Margin="0,0,7,0" Click="FontPlus_Click"/>
            <Button x:Name="FullscreenButton" Content="⛶" Style="{StaticResource OutlineButton}" ToolTip="Полный экран (F11)" Margin="0,0,7,0" Click="Fullscreen_Click"/>
            <Button x:Name="FindLyricsButton" Content="Найти" Style="{StaticResource OutlineButton}"
                    ToolTip="Найти текст в Legacy Bridge, LRCLIB и lyrics.ovh" Margin="0,0,7,0"
                    Click="FindLyrics_Click"/>
            <Button Content="LRC" Style="{StaticResource OutlineButton}" ToolTip="Открыть локальный LRC" Margin="0" Click="OpenLrc_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
