<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Enso/AIMP Design System v1: colors, spacing, geometry and type.
       The 4-DIP spatial scale is deliberate; runtime accent is overridable. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#101114"/>
  <SolidColorBrush x:Key="StageBrush" Color="#0D0E11"/>
  <SolidColorBrush x:Key="ChromeBrush" Color="#16171B"/>
  <SolidColorBrush x:Key="ToolbarBrush" Color="#19191F"/>
  <SolidColorBrush x:Key="DrawerBrush" Color="#19191F"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#373540"/>
  <SolidColorBrush x:Key="SubtleStrokeBrush" Color="#292831"/>
  <SolidColorBrush x:Key="ControlBrush" Color="#24232B"/>
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#302C38"/>
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#3B3348"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#17171D"/>
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#202027"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F0EDF6"/>
  <SolidColorBrush x:Key="SecondaryBrush" Color="#C4BECD"/>
  <SolidColorBrush x:Key="DimBrush" Color="#A19BAE"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#8A7BB7"/>
  <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#342B46"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#453657"/>
  <SolidColorBrush x:Key="HighlightBrush" Color="#DDD2FF"/>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#D7CBFF"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#9BCAA9"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#EDBF91"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#F2ADB4"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#342C46"/>

  <!-- Vocal-focus semantics are retained for existing timed highlighting. -->
  <SolidColorBrush x:Key="LyricsSungBrush" Color="#F3EEFF"/>
  <SolidColorBrush x:Key="LyricsActiveBrush" Color="#CFC2ED"/>
  <SolidColorBrush x:Key="LyricsNextBrush" Color="#DDD1F5"/>
  <SolidColorBrush x:Key="LyricsNearBrush" Color="#B5ADC6"/>
  <SolidColorBrush x:Key="LyricsFarBrush" Color="#AAA3BB"/>

  <!-- 4-DIP baseline; structural chrome/drawer numbers live in DesignMetrics.cs. -->
  <sys:Double x:Key="DS.Space.1">4</sys:Double>
  <sys:Double x:Key="DS.Space.2">8</sys:Double>
  <sys:Double x:Key="DS.Space.3">12</sys:Double>
  <sys:Double x:Key="DS.Space.4">16</sys:Double>
  <sys:Double x:Key="DS.Space.6">24</sys:Double>
  <sys:Double x:Key="DS.Space.8">32</sys:Double>
  <sys:Double x:Key="DS.Control.Height">36</sys:Double>
  <sys:Double x:Key="DS.Control.HeightCompact">32</sys:Double>
  <sys:Double x:Key="DS.Type.Caption">10</sys:Double>
  <sys:Double x:Key="DS.Type.Body">12</sys:Double>
  <sys:Double x:Key="DS.Type.Label">11</sys:Double>
  <sys:Double x:Key="DS.Type.Heading">16</sys:Double>
  <sys:Double x:Key="DS.Type.Display">24</sys:Double>
  <CornerRadius x:Key="DS.Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="DS.Radius.Card">8</CornerRadius>
  <CornerRadius x:Key="DS.Radius.Small">4</CornerRadius>
  <Thickness x:Key="DS.Inset.Button">12,7</Thickness>
  <Thickness x:Key="DS.Inset.Field">12,7</Thickness>
  <Thickness x:Key="DS.Inset.Drawer">20,20,20,24</Thickness>
  <Thickness x:Key="DS.Inset.Window">20,0</Thickness>
  <Thickness x:Key="DS.Inset.Result">12,10</Thickness>
  <Thickness x:Key="DS.Inset.Card">16</Thickness>
</ResourceDictionary>
