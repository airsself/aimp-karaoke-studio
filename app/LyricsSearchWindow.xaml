<Window x:Class="KaraokeStudio.LyricsSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Поиск текстов · AIMP Karaoke Studio" Width="880" Height="640"
        MinWidth="620" MinHeight="470" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" SnapsToDevicePixels="True" UseLayoutRounding="True"
        Loaded="SearchWindow_Loaded" Closing="SearchWindow_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}"
              BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="DialogTitlebar_MouseLeftButtonDown">
        <Grid Margin="16,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="20" Height="20" Background="{DynamicResource ControlBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource DS.Radius.Small}" VerticalAlignment="Center">
            <TextBlock Text="A" Foreground="{DynamicResource TextBrush}" FontWeight="Bold"
                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Grid.Column="1" Text="AIMP Karaoke Studio · Поиск текстов"
                     Foreground="{DynamicResource TextBrush}" FontSize="11"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
          <Button Grid.Column="2" Content="×" Style="{StaticResource WindowControl}"
                  AutomationProperties.Name="Закрыть окно поиска"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Закрыть поиск" Click="CloseButton_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="ПОИСК ТЕКСТОВ" Style="{StaticResource PanelTitle}"/>
          <TextBlock Text="Legacy Bridge → LRCLIB → lyrics.ovh" Style="{StaticResource HelperText}"
                     Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="LYRICS DISCOVERY" Style="{StaticResource PanelLabel}" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="ИСПОЛНИТЕЛЬ" Style="{StaticResource PanelLabel}" Margin="0,0,0,8"/>
          <TextBox x:Name="ArtistInput" Style="{StaticResource StudioTextBox}"
                   AutomationProperties.Name="Исполнитель" KeyDown="SearchField_KeyDown"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource PanelLabel}" Margin="0,0,0,8"/>
          <TextBox x:Name="TitleInput" Style="{StaticResource StudioTextBox}"
                   AutomationProperties.Name="Название композиции" KeyDown="SearchField_KeyDown"/>
        </StackPanel>
        <Button x:Name="SearchButton" Grid.Column="3" Margin="16,0,0,0" Content="Найти" MinWidth="96"
                VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}" Click="SearchButton_Click"/>
      </Grid>
      <Grid Grid.Row="2" MinHeight="130">
        <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource StudioCard}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ВАРИАНТЫ ТЕКСТА" Style="{StaticResource PanelLabel}"
                       Padding="16,16,12,12"/>
            <Grid>
            <ListBox x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged"
                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                     ItemContainerStyle="{StaticResource DiscoveryResultItem}"
                     AutomationProperties.Name="Найденные варианты текста"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource StudioVerticalScrollBar}"/>
              </ListBox.Resources>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding DisplayDetail}" TextWrapping="Wrap"
                               Margin="0,8,0,0" FontSize="11"
                               Foreground="{DynamicResource SecondaryBrush}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              <TextBlock x:Name="ResultsPlaceholder" IsHitTestVisible="False"
                         Text="Варианты появятся после поиска" TextWrapping="Wrap"
                         TextAlignment="Center" MaxWidth="240" Margin="18"
                         Foreground="{DynamicResource DimBrush}" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource StudioCard}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ПРЕДПРОСМОТР" Style="{StaticResource PanelLabel}"
                       Padding="16,16,12,12"/>
            <TextBox x:Name="PreviewText" Text="Выберите найденный текст."
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Style="{StaticResource StudioTextBox}" Height="Auto" VerticalContentAlignment="Top"
                     Background="Transparent" Foreground="{DynamicResource SecondaryBrush}" BorderThickness="0"
                     FontSize="12" Padding="16,8,16,16">
              <TextBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource StudioVerticalScrollBar}"/>
              </TextBox.Resources>
            </TextBox>
          </DockPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="3" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="SearchStatus" Text="Введите название и исполнителя."
                     Style="{StaticResource HelperText}"/>
          <CheckBox x:Name="LegacyBridgeCheck" Content="Проверять локальный Lyrics Bridge"
                    IsChecked="True" Style="{StaticResource SettingCheck}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
          <Button Content="Закрыть" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                  Click="CloseButton_Click"/>
          <Button x:Name="ApplyButton" Content="Применить" IsEnabled="False"
                  Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ApplyButton_Click"/>
          <Button x:Name="DownloadButton" Content="Сохранить LRC…" IsEnabled="False"
                  Style="{StaticResource OutlineButton}" Click="DownloadButton_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
    </Grid>
  </Border>
</Window>