<Application x:Class="KaraokeStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- AIMP 5.40-inspired palette from the approved design v1 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#111112"/>
    <SolidColorBrush x:Key="StageBrush" Color="#101011"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#161618"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#151516"/>
    <SolidColorBrush x:Key="DrawerBrush" Color="#18181A"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#29292C"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E9E8ED"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#98979F"/>
    <SolidColorBrush x:Key="DimBrush" Color="#77757F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8A7BB7"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#AC9ADC"/>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A6A3AE"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="#28252E"/>
                <Setter Property="Foreground" Value="#EAE5F6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="#393145"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Background" Value="#1D1B21"/>
      <Setter Property="BorderBrush" Value="#34313B"/>
    </Style>
    <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="1,0"/>
    </Style>
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="6,5"/>
    </Style>
    <Style x:Key="WindowControl" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Width" Value="35"/>
      <Setter Property="Height" Value="37"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SmallText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#807D88"/>
      <Setter Property="Margin" Value="0,19,0,13"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#B5A9D1"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="SettingSlider" TargetType="Slider">
      <Setter Property="Height" Value="19"/>
      <Setter Property="Margin" Value="0,7,0,7"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="19" VerticalAlignment="Center">
              <Track x:Name="PART_Track" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}" Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource AccentBrush}" Height="3" CornerRadius="1"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="12" Height="12" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource AccentBrush}" Stroke="#B6A5D2" StrokeThickness="0.5"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="#39363F" Height="3" CornerRadius="1"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundPlay" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#17151B"/>
      <Setter Property="Foreground" Value="#E9E8ED"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="34" Height="34">
              <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Fill" Value="#302B3C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LyricProgress" TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border x:Name="PART_Track" Background="#48414D" CornerRadius="1" ClipToBounds="True">
              <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBrush}" CornerRadius="1" HorizontalAlignment="Left"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SwatchButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="5"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#B1ADB8"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,9"/>
    </Style>
  </Application.Resources>
</Application>
